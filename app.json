{
  "expo": {
    "name": "Wordistan",
    "slug": "wordistan-mobile",
    "version": "1.0.0",
    "scheme": "wordistan",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wordistan.mobile",
      "icon": "./assets/logo.png"
    },
    "android": {
      "package": "com.wordistan.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "6dd0d5b2-7699-428a-a918-dbbdbe9c442b"
      }
    }
  }
}
